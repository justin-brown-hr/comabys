# --- Contact form delivery (pick ONE) ---

# Option A (recommended, free, ~30 seconds): https://web3forms.com
# Create an access key for info@comabys.com, then set:
WEB3FORMS_ACCESS_KEY=

# Option B: SMTP (e.g. Network Solutions / Google Workspace)
